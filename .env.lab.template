# ════════════════════════════════════════════════════════════════════════
# LAB environment template — paper sandbox copy of Illuminati
# ════════════════════════════════════════════════════════════════════════
# These go into the LAB GitHub repo's Actions secrets (Settings → Secrets and
# variables → Actions). Fill every <...> placeholder. Full runbook:
# ~/.claude/plans/lab-environment-setup.md         (built 2026-06-04)
#
# GUARDRAIL: the lab uses PAPER Alpaca keys + a SEPARATE Supabase project, so it
# can never trade real money or pollute the live system's data.
# ════════════════════════════════════════════════════════════════════════

# --- Environment marker (THIS is what makes a deploy "the lab") ---
SYSTEM_ENV=lab

# --- Alpaca: PAPER keys ONLY. NEVER put live keys in the lab. ---
ALPACA_API_KEY=<paper_api_key>
ALPACA_SECRET_KEY=<paper_secret_key>
ALPACA_LIVE_MODE=false

# --- Supabase: the SECOND (lab) project — NEVER the prod project ---
SUPABASE_URL=<lab_supabase_url>
SUPABASE_KEY=<lab_anon_key>
SUPABASE_SERVICE_KEY=<lab_service_role_key>

# --- Slack: the #illuminati-lab webhook (keeps lab noise out of live) ---
SLACK_WEBHOOK_URL=<lab_slack_webhook>

# --- Shared API keys (safe to reuse prod's values) ---
ANTHROPIC_API_KEY=<anthropic_key>
ALPHA_VANTAGE_KEY=<alpha_vantage_key>

# --- Position sizing (paper). Mirror live (~25000) for apples-to-apples. ---
BANKROLL=25000

# --- GitHub PAT for self-heal / workflow dispatch (lab repo) ---
ILLUMINATI_PAT=<github_pat_for_lab_repo>
